// Skema NADA. Default SQLite agar langsung jalan tanpa instalasi.
// Untuk PostgreSQL: ganti provider menjadi "postgresql" dan DATABASE_URL (lihat README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  role             String    @default("BUYER") // BUYER | ADMIN
  resetTokenHash   String?
  resetExpires     DateTime?
  createdAt        DateTime  @default(now())
  orders           Order[]
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String         @default("")
  material    String         @default("")
  category    String         @default("Abaya")
  price       Int
  status      String         @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  featured    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  colors      ProductColor[]
  stories     Story[]
}

// Satu warna milik satu produk; foto disimpan per warna supaya foto ikut berganti saat swatch dipilih.
model ProductColor {
  id        Int              @id @default(autoincrement())
  productId Int
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  position  Int              @default(0)
  images    ProductImage[]
  variants  ProductVariant[]
}

model ProductImage {
  id       Int          @id @default(autoincrement())
  colorId  Int
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url      String
  position Int          @default(0)
}

// Varian = warna + ukuran. Stok dihitung di sini.
model ProductVariant {
  id         Int          @id @default(autoincrement())
  colorId    Int
  color      ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size       String
  stock      Int          @default(0)
  orderItems OrderItem[]

  @@unique([colorId, size])
}

model Story {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  cover       String    @default("")
  excerpt     String    @default("")
  body        String    @default("")
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Order {
  id             Int         @id @default(autoincrement())
  code           String      @unique
  userId         Int
  user           User        @relation(fields: [userId], references: [id])
  status         String      @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DONE | CANCELLED
  recipient      String
  phone          String
  address        String
  city           String
  postalCode     String
  subtotal       Int
  shippingFee    Int
  total          Int
  trackingNumber String      @default("")
  paymentUrl     String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  colorName   String
  size        String
  image       String          @default("")
  price       Int
  qty         Int
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Pengaturan situs disimpan sebagai satu baris JSON (key "main").
model SiteSetting {
  key   String @id
  value String
}
